{
  "expo": {
    "name": "PocketPal",
    "slug": "pocketpal",
    "version": "1.3.16",
    "orientation": "portrait",
    "icon": "./assets/images/pocketpal-icon.png",
    "scheme": "pocketpal",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.pocketpal.studentbudget",
      "adaptiveIcon": {
        "backgroundColor": "#173D34",
        "foregroundImage": "./assets/images/pocketpal-foreground.png",
        "monochromeImage": "./assets/images/pocketpal-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/pocketpal-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#255C4F",
          "image": "./assets/images/pocketpal-mark.png",
          "imageWidth": 108
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c3cd0e86-7955-463a-90bf-2cef883d5da3"
      }
    },
    "owner": "priveer"
  }
}
