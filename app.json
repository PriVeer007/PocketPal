{
  "expo": {
    "name": "Pennywise",
    "slug": "pennywise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pennywise-icon.png",
    "scheme": "pennywise",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.pennywise.studentbudget",
      "adaptiveIcon": {
        "backgroundColor": "#173D34",
        "foregroundImage": "./assets/images/pennywise-foreground.png",
        "monochromeImage": "./assets/images/pennywise-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/pennywise-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#255C4F",
          "image": "./assets/images/pennywise-mark.png",
          "imageWidth": 108
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "817d9e56-96fc-4953-b819-e0429f4708c9"
      }
    }
  }
}
